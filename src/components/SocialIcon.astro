---
import type { SocialIcon } from "../data/profile";

interface Props {
  name: SocialIcon;
}

const { name } = Astro.props;
---

{
  name === "instagram" && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3.25" y="3.25" width="17.5" height="17.5" rx="5" />
      <circle cx="12" cy="12" r="4.1" />
      <circle class="fill" cx="17.35" cy="6.7" r="1" />
    </svg>
  )
}
{
  name === "youtube" && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        class="fill"
        d="M22.2 8.1a3 3 0 0 0-2.1-2.1C18.4 5.5 12 5.5 12 5.5s-6.4 0-8.1.5a3 3 0 0 0-2.1 2.1A31 31 0 0 0 1.3 12a31 31 0 0 0 .5 3.9 3 3 0 0 0 2.1 2.1c1.7.5 8.1.5 8.1.5s6.4 0 8.1-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-3.9 31 31 0 0 0-.5-3.9zM10.1 15.2V8.8l5.4 3.2-5.4 3.2z"
      />
    </svg>
  )
}
{
  name === "linkedin" && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        class="fill"
        d="M5.7 9.2H8.4V18.5H5.7zM7.05 4.7a1.55 1.55 0 1 1 0 3.1 1.55 1.55 0 0 1 0-3.1zM10.2 9.2h2.55v1.27h.04c.36-.67 1.23-1.38 2.53-1.38 2.7 0 3.2 1.78 3.2 4.09v5.32h-2.66v-4.72c0-1.13-.02-2.58-1.57-2.58-1.58 0-1.82 1.23-1.82 2.5v4.8H10.2z"
      />
    </svg>
  )
}
{
  name === "x" && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        class="fill"
        d="M14.7 10.4 21.4 3h-1.6l-5.8 6.4L9.3 3H3.4l7 10-7 7.7h1.6l6.1-6.8 4.9 6.8h5.9l-7.2-10.3zm-2.2 2.4-.7-1-5.6-7.6h2.4l4.5 6.2.7 1 5.9 8h-2.4l-4.8-6.6z"
      />
    </svg>
  )
}
{
  name === "tiktok" && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        class="fill"
        d="M14.1 3.2c.5 2.6 2 4.4 4.4 5v2.5a7.2 7.2 0 0 1-4.4-1.5v6.7a5.6 5.6 0 1 1-5.6-5.6c.3 0 .7 0 1 .1v2.7a2.9 2.9 0 1 0 2 2.8V3.2h2.6z"
      />
    </svg>
  )
}
