---
import SocialIcon from "../components/SocialIcon.astro";
import { profile } from "../data/profile";
import "../styles/global.css";

const shareImage = new URL(profile.photo, Astro.url).href;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}</title>
    <meta name="description" content={profile.phrase} />
    <meta property="og:title" content={profile.name} />
    <meta property="og:description" content={profile.phrase} />
    <meta property="og:type" content="profile" />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={profile.name} />
    <meta name="twitter:description" content={profile.phrase} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,560;1,6..96,500&family=Outfit:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="scene" aria-hidden="true">
      <div class="bloom"></div>
    </div>
    <main>
      <div class="portrait">
        <img
          src={profile.photo}
          alt={profile.photoAlt}
          width="640"
          height="640"
        />
      </div>
      <header class="identity">
        <h1>{profile.name}</h1>
        <p>{profile.phrase}</p>
      </header>
      <nav class="links" aria-label="Redes sociales">
        {
          profile.links.map((link) => (
            <a
              class="link"
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="icon">
                <SocialIcon name={link.icon} />
              </span>
              <span class="label">{link.label}</span>
            </a>
          ))
        }
      </nav>
    </main>
  </body>
</html>
